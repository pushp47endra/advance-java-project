<%@ tag body-content="empty" pageEncoding="UTF-8" %><%@ attribute name="product" required="true" type="com.shopsphere.model.Product" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<a class="product-card" href="${pageContext.request.contextPath}/product?id=${product.productId}"><div class="product-photo"><c:if test="${not empty product.imageUrl}"><img loading="lazy" src="${product.imageUrl}" alt=""></c:if><c:if test="${product.discount gt 0}"><span class="discount">-${product.discount}%</span></c:if></div><div class="product-info"><p class="muted"><c:out value="${product.brand}"/></p><h3><c:out value="${product.name}"/></h3><div class="price">₹${product.salePrice}<c:if test="${product.discount gt 0}"><s>₹${product.price}</s></c:if></div><span class="see">Explore product →</span></div></a>
