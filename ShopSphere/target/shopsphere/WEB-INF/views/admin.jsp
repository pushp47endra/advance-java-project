<%@ include file="fragments/header.jspf" %><section class="content"><span class="eyebrow dark">SHOPSPHERE BACK OFFICE</span><h1>Admin workspace.</h1><div class="tabs"><a href="${pageContext.request.contextPath}/admin">Overview</a><a href="${pageContext.request.contextPath}/admin/products">Products</a><a href="${pageContext.request.contextPath}/admin/orders">Orders</a><a href="${pageContext.request.contextPath}/admin/categories">Categories</a><a href="${pageContext.request.contextPath}/admin/users">Customers</a></div>
<c:if test="${section eq 'dashboard'}"><div class="stats"><div class="stat"><strong>${fn:length(products)}</strong><span>Total products</span></div><div class="stat"><strong>${fn:length(orders)}</strong><span>Orders</span></div><div class="stat"><strong>${fn:length(customers)}</strong><span>Users</span></div></div><h2>Recent orders</h2></c:if>
<c:if test="${section eq 'products'}"><h2>Add or update product</h2><form method="post" class="admin-form"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="number" name="id" min="0" placeholder="ID (0 for new)" value="0"><input name="name" placeholder="Product name" required><input name="brand" placeholder="Brand"><input type="number" name="category" placeholder="Category ID" value="1" min="1" required><input name="description" placeholder="Description"><input name="image" placeholder="Image URL"><input type="number" name="price" step="0.01" min="0" placeholder="Price" required><input type="number" name="stock" min="0" placeholder="Stock" required><button class="btn">Save product</button></form><div class="table-wrap"><table><tr><th>ID</th><th>Name</th><th>Price</th><th>Stock</th><th>Active</th><th>Action</th></tr><c:forEach var="p" items="${products}"><tr><td>${p.productId}</td><td><c:out value="${p.name}"/></td><td>₹${p.price}</td><td>${p.stock}</td><td>${p.status}</td><td><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${p.productId}"><button name="action" value="delete" class="outline">Deactivate</button></form></td></tr></c:forEach></table></div></c:if>
<c:if test="${section eq 'orders' or section eq 'dashboard'}"><div class="table-wrap"><table><tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th><th>Update</th></tr><c:forEach var="o" items="${orders}"><tr><td>#${o.order_id}</td><td><c:out value="${o.customer}"/></td><td>₹${o.total_amount}</td><td>${o.order_status}</td><td><form method="post" action="${pageContext.request.contextPath}/admin/orders"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${o.order_id}"><select name="status"><option>PLACED</option><option>PROCESSING</option><option>SHIPPED</option><option>DELIVERED</option><option>CANCELLED</option></select><button class="outline">Update</button></form></td></tr></c:forEach></table></div></c:if>
<c:if test="${section eq 'categories'}"><h2>Add category</h2><form method="post" class="admin-form"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input name="name" placeholder="Category name" required><input name="description" placeholder="Description"><button class="btn">Add</button></form><div class="table-wrap"><table><tr><th>ID</th><th>Name</th><th>Description</th></tr><c:forEach var="c" items="${categories}"><tr><td>${c.category_id}</td><td><c:out value="${c.name}"/></td><td><c:out value="${c.description}"/></td></tr></c:forEach></table></div></c:if>
<c:if test="${section eq 'users'}"><div class="table-wrap"><table><tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th></tr><c:forEach var="c" items="${customers}"><tr><td>${c.user_id}</td><td><c:out value="${c.name}"/></td><td><c:out value="${c.email}"/></td><td>${c.role}</td></tr></c:forEach></table></div></c:if></section><%@ include file="fragments/footer.jspf" %>
