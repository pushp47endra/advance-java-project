<%@ include file="fragments/header.jspf" %><section class="content"><span class="eyebrow dark">YOUR ACCOUNT</span><h1>Order history.</h1><c:if test="${not empty param.placed}"><div class="success">Order #${fn:escapeXml(param.placed)} placed successfully!</div></c:if><div class="table-wrap"><table><thead><tr><th>Order</th><th>Date</th><th>Total</th><th>Status</th><th>Payment</th></tr></thead><tbody><c:forEach var="o" items="${orders}"><tr><td>#${o.order_id}</td><td>${o.created_at}</td><td>₹${o.total_amount}</td><td><span class="status"><c:out value="${o.order_status}"/></span></td><td>${o.payment_status}</td></tr></c:forEach></tbody></table></div><c:if test="${empty orders}"><div class="empty">No orders yet.</div></c:if></section><%@ include file="fragments/footer.jspf" %>
