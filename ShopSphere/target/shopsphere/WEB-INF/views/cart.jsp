<%@ include file="fragments/header.jspf" %><section class="content"><span class="eyebrow dark">YOUR SELECTION</span><h1>Shopping bag.</h1><c:choose><c:when test="${empty items}"><div class="empty">Your bag is empty. <a href="${pageContext.request.contextPath}/products">Discover products →</a></div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Product</th><th>Price</th><th>Quantity</th><th>Subtotal</th><th></th></tr></thead><tbody><c:set var="total" value="0"/><c:forEach var="item" items="${items}"><tr><td><c:out value="${item.name}"/></td><td>₹${item.sale_price}</td><td><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="productId" value="${item.product_id}"><input type="number" min="0" max="${item.stock}" value="${item.quantity}" name="quantity"><button class="outline">Update</button></form></td><td>₹${item.sale_price * item.quantity}</td><td><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="productId" value="${item.product_id}"><input type="hidden" name="quantity" value="0"><button class="link-btn">Remove</button></form></td></tr><c:set var="total" value="${total + item.sale_price * item.quantity}"/></c:forEach></tbody></table></div><div class="cart-bottom"><h2>Total: ₹${total}</h2><a class="btn" href="${pageContext.request.contextPath}/checkout">Checkout →</a></div></c:otherwise></c:choose></section><%@ include file="fragments/footer.jspf" %>
