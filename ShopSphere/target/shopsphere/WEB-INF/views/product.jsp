<%@ include file="fragments/header.jspf" %><c:choose><c:when test="${empty product}"><div class="empty">Product not found.</div></c:when><c:otherwise><section class="product-detail"><div class="detail-photo"><img src="${product.imageUrl}" alt=""></div><div><span class="eyebrow dark">THE SHOPSPHERE SELECTION</span><p class="muted"><c:out value="${product.brand}"/></p><h1><c:out value="${product.name}"/></h1><p class="detail-price">₹${product.salePrice} <s>₹${product.price}</s></p><p><c:out value="${product.description}"/></p><p class="stock">${product.stock} in stock</p><c:choose><c:when test="${product.stock gt 0}"><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="productId" value="${product.productId}"><label>Quantity <input type="number" min="1" max="${product.stock}" name="quantity" value="1"></label><button class="btn" type="submit">Add to cart →</button></form></c:when><c:otherwise><p>Sold out</p></c:otherwise></c:choose><form method="post" action="${pageContext.request.contextPath}/wishlist"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="productId" value="${product.productId}"><button class="outline">♡ Save to wishlist</button></form><c:if test="${not empty sessionScope.user}"><form method="post" action="${pageContext.request.contextPath}/review"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="productId" value="${product.productId}"><label>Leave a rating<select name="rating"><option value="5">5 stars</option><option value="4">4 stars</option><option value="3">3 stars</option><option value="2">2 stars</option><option value="1">1 star</option></select></label><textarea name="text" placeholder="Your review" maxlength="1000"></textarea><button class="outline">Submit review</button></form></c:if></div></section></c:otherwise></c:choose><%@ include file="fragments/footer.jspf" %>
